# Copy to .env and fill in the blanks. Full reference + field-by-field
# explanation lives at docs/tech/configuration.md.

# ---- fastify (always required) ----
APP_HOST=0.0.0.0
APP_PORT=3001
LOG_LEVEL=info

# ---- AWS KMS (required) ----
# AWS_* credentials are optional when running on AWS infra with an
# instance/task role. Always set KMS_KEY_ID_VALIDATOR.
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
KMS_KEY_ID_VALIDATOR=

# ---- PEM verification (required) ----
# Path on disk OR an https:// URL serving the relayer's PEM public key.
CALLER_PEM_PUBLIC_KEY_PATH=resources/relayer.pem
# Required for https:// PEM URLs. Optional for local files, but recommended.
CALLER_PEM_PUBLIC_KEY_SHA256=

# ---- CEX risk check (required) ----
# /sign refuses to sign user-scoped withdraws unless CEX /verify returns
# {"code":0,"data":true} for the requestId.
CEX_API_URL=https://cex.example.com

# ---- Admin endpoints / web proxy (required if /admin/* or the SPA relayer proxy is used) ----
# Global relayer base URL. This is intentionally not per-chain config.
RELAYER_URL=http://relayer:3000

# ---- Docker single-image deploy (required when running via Docker) ----
# Single shared password for the admin SPA + /admin/* signing endpoints.
# Username is hardcoded `admin`. Container fails to start if unset.
ADMIN_BASIC_AUTH_PASSWORD=change-me
# ---- Admin SPA chain registry (required to serve the SPA) ----
# JSON array of per-chain deployment overrides. rpcUrl is the chain-specific
# upstream for live chain reads; pass "" to disable graphUrl. See
# docs/tech/configuration.md for details.
CHAIN_CONFIGS=[{"chainId":42161,"vaultAddress":"0x949556cb8634F9a4a8504665C3d0D9d326c600b2","graphUrl":"","rpcUrl":"https://solitary-empty-shard.arbitrum-mainnet.quiknode.pro/c3231ec35435fecf285eaa7e4b5010dc75881ec0/"}]
