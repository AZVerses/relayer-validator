# ----- Frontend (read by Vite dev and injected by Docker runtime) -----
# JSON array of per-chain deployment and routing config. graphUrl="" uses the relayer for
# tokens and validator sets. Per-chain relayerUrl is also used by Vite dev.
CHAIN_CONFIGS=[{"chainId":42161,"vaultAddress":"0x949556cb8634F9a4a8504665C3d0D9d326c600b2","graphUrl":"","rpcUrl":"https://your-arbitrum-rpc.example","relayerUrl":"http://arbitrum-relayer:3000"}]

# ----- Docker runtime (standalone web-only image) -----
# Optional legacy fallback when an entry omits relayerUrl.
RELAYER_URL=
VALIDATOR_SERVICE_URL=http://validator-service:3001

# ----- Docker host port -----
HOST_PORT=8080
